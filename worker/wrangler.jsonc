{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "weipic-api",
	"main": "src/index.js",
	"compatibility_date": "2026-08-10",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "https://weipic.github.io,http://localhost:8000,http://127.0.0.1:8000",
		"TOKEN_TTL_SECONDS": "900",
		"CLOUDFLARE_ACCOUNT_ID": "67d372f2e0d54d39e6703405e3e0824e",
		"R2_BUCKET_NAME": "weipic-deliveries"
	},
	"kv_namespaces": [
		{
			"binding": "GALLERY_CONFIG",
			"id": "aa28feae36094207a4115385fe17021f"
		}
	],
	"r2_buckets": [
		{
			"binding": "GALLERY_BUCKET",
			"bucket_name": "weipic-deliveries"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"cache": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}
